// File name: projects/1/Or.hdl
/**
 * Or gate:
 * if (a or b) out = 1, else out = 0 
 */
CHIP Or {
    IN a, b;
    OUT out;

    PARTS:
    Nand(a=a , b=a , out=anandOut );
    Nand(a=b , b=b , out=bnandOut );
    Nand(a= anandOut, b=bnandOut , out=out );

    //// Replace this comment with your code.
}